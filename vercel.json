{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' *.marketingcloudapps.com *.exacttarget.com *.salesforce.com" }
            ]
        }
    ]
}