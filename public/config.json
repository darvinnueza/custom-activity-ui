{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "images/icon40.png",
    "category": "custom"
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "Custom Activity Demo",
      "description": "Custom Activity Demo"
    }
  },
  "arguments": {
    "execute": {
        "inArguments": [
          { "request_id": "{{Event.request_id}}" },
          { "contact_key": "{{Event.contact_key}}" },
          { "msisdn": "{{Event.msisdn}}" }
        ],
        "outArguments": [],
        "url": "https://custom-activity-service.vercel.app/api/sfmc/execute",
        "useJwt": true
    }
  },
  "configurationArguments": {
    "applicationExtensionKey": "366758bd-3a42-493d-af36-723b782bcfde",
    "save": { "url": "https://custom-activity-service.vercel.app/api/sfmc/save", "useJwt": true },
    "publish": { "url": "https://custom-activity-service.vercel.app/api/sfmc/publish", "useJwt": true },
    "validate": { "url": "https://custom-activity-service.vercel.app/api/sfmc/validate", "useJwt": true },
    "stop": { "url": "https://custom-activity-service.vercel.app/stop", "useJwt": true }
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://custom-activity-ui-two.vercel.app/",
      "height": 600,
      "width": 800,
      "fullscreen": false,
      "useJwt": true
    }
  }
}